# Mithic Caddyfile
# Reverse proxy + static SPA
#
# IMPORTANT: try_files is evaluated before reverse_proxy by default.
# Put API / ActivityPub / WebSocket behind `handle` so they are not
# rewritten to index.html.

{
	admin off
}

:80, :3000 {
	log {
		output stdout
	}

	root * /usr/share/caddy
	encode gzip zstd

	# OGP bots (Discord, Twitter, Slack, Googlebot, ...)
	@bots {
		header_regexp User-Agent "(?i)(discordbot|twitterbot|slackbot|telegrambot|whatsapp|googlebot|bingbot|facebot|facebookexternalhit|baiduspider|yandexbot)"
		path_regexp path "^/(notes|profile)/"
	}
	handle @bots {
		reverse_proxy backend:3000
	}

	# REST API - must match before SPA fallback
	handle /api/* {
		reverse_proxy backend:3000
	}

	# WebSocket
	@ws {
		header Connection *Upgrade*
		header Upgrade websocket
	}
	handle @ws {
		reverse_proxy backend:3000
	}

	# ActivityPub / Federation
	@activitypub {
		path_regexp path "^/(\.well-known/|nodeinfo|users/|inbox)"
	}
	handle @activitypub {
		reverse_proxy backend:3000
	}

	# Static SPA (last)
	handle {
		@immutable_assets {
			path *.wasm *.js
		}
		header @immutable_assets Cache-Control "public, max-age=31536000, immutable"

		@cached_assets {
			path *.css *.svg *.ico *.png *.jpg *.webp *.woff2
		}
		header @cached_assets Cache-Control "public, max-age=604800, no-transform"

		try_files {path} {path}/ /index.html

		@index {
			path /index.html
		}
		header @index Cache-Control "no-cache"

		file_server
	}
}
