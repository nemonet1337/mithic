# =============================================================================
# Dockerfile.release — GitHub Releases上のビルド済みバイナリを取得
#
# ビルド時に VERSION を指定（デフォルト 0.1.0）:
#   docker build -f Dockerfile.release --target server --build-arg VERSION=0.2.0 .
# =============================================================================

ARG VERSION=0.1.0

# =============================================================================
# Stage 1: Server runtime (release binary)
# =============================================================================
FROM debian:bookworm-slim AS server
RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    curl \
    xz-utils \
    && rm -rf /var/lib/apt/lists/*

ARG VERSION
RUN curl -sSLf "https://github.com/nemonet1337/mithic/releases/download/v${VERSION}/mithic-v${VERSION}-x86_64-unknown-linux-musl.tar.xz" \
    | tar -xJf - --strip-components=1 -C /usr/local/bin/ "mithic-v${VERSION}-x86_64-unknown-linux-musl/mithic-server" \
    && chmod +x /usr/local/bin/mithic-server

EXPOSE 3000
ENTRYPOINT ["mithic-server"]

# =============================================================================
# Stage 2: Worker runtime (release binary)
# =============================================================================
FROM debian:bookworm-slim AS worker
RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    curl \
    xz-utils \
    && rm -rf /var/lib/apt/lists/*

ARG VERSION
RUN curl -sSLf "https://github.com/nemonet1337/mithic/releases/download/v${VERSION}/mithic-v${VERSION}-x86_64-unknown-linux-musl.tar.xz" \
    | tar -xJf - --strip-components=1 -C /usr/local/bin/ "mithic-v${VERSION}-x86_64-unknown-linux-musl/mithic-worker" \
    && chmod +x /usr/local/bin/mithic-worker

ENTRYPOINT ["mithic-worker"]

# =============================================================================
# Stage 3: Frontend (WASM はリリースバイナリ配布対象外のためソースビルド)
# =============================================================================
FROM rust:1.94-bookworm AS frontend-builder
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    curl \
    clang \
    mold \
    && rm -rf /var/lib/apt/lists/*

RUN rustup target add wasm32-unknown-unknown
RUN curl -sSLf \
    https://github.com/trunk-rs/trunk/releases/latest/download/trunk-x86_64-unknown-linux-gnu.tar.gz \
    | tar -xzf - -C /usr/local/bin

WORKDIR /app
COPY . .
WORKDIR /app/frontend-web
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/app/target,sharing=locked \
    trunk build --release

FROM caddy:alpine AS frontend
COPY --from=frontend-builder /app/frontend-web/dist /usr/share/caddy
COPY infra/caddy/Caddyfile /etc/caddy/Caddyfile
EXPOSE 80
EXPOSE 443
EXPOSE 3000
