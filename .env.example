# SurrealDB
SURREALDB_ENDPOINT=ws://surrealdb:8000
SURREALDB_NAMESPACE=mithic
SURREALDB_DATABASE=main
SURREALDB_USERNAME=root
SURREALDB_PASSWORD=change-me

# Dragonfly (Redis-compatible)
DRAGONFLY_URL=redis://dragonfly:6379

# JWT (必須。change-me-in-production や空文字は拒否される)
JWT_SECRET=dev-only-replace-with-long-random-string
JWT_EXPIRY_HOURS=24

# リバースプロキシ背後でのみ true (X-Forwarded-For をクライアント IP に使う)
# TRUST_PROXY=false

# Server
SERVER_PORT=3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost,http://127.0.0.1,http://localhost:1420,http://127.0.0.1:1420

# File storage. STORAGE_TYPE: local | s3
# s3 のカスタム endpoint は path-style。RustFS も STORAGE_TYPE=s3 で指す。
# endpoint があるときは ACCESS_KEY と SECRET_KEY が必須。バケットは事前に作る。
# STORAGE_S3_PUBLIC_URL を空にすると /uploads/{hash} 経由で配信する。
STORAGE_TYPE=s3
STORAGE_S3_ENDPOINT=http://rustfs:9000
STORAGE_S3_BUCKET=mithic-media
STORAGE_S3_ACCESS_KEY=mithic
STORAGE_S3_SECRET_KEY=mithic-dev-secret
STORAGE_S3_REGION=us-east-1
# STORAGE_S3_PUBLIC_URL=
# ローカル FS に戻すとき:
# STORAGE_TYPE=local
# LOCAL_STORAGE_PATH=/app/files

# Instance
INSTANCE_URL=http://localhost:3000
INSTANCE_NAME=Mithic

# Web Push (optional). URL-safe base64 raw EC private key (32 bytes).
# Generate e.g. with: npx web-push generate-vapid-keys
# VAPID_PRIVATE_KEY=
# VAPID_CONTACT=mailto:admin@example.com
