# PostgreSQL
DATABASE_URL=postgres://mithic:mithic-dev-password@localhost:5432/mithic
DATABASE_POOL_MAX=10

# Redis（キャッシュ / キュー / レート制限）
REDIS_URL=redis://localhost:6379

# Server
SERVER_PORT=3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
TRUST_PROXY=false
JWT_SECRET=change-me-in-production
JWT_EXPIRY_HOURS=24

# File storage. STORAGE_S3_ENABLED: true | false (default false = local filesystem)
STORAGE_S3_ENABLED=false
# STORAGE_S3_ENDPOINT=http://localhost:9000
# STORAGE_S3_BUCKET=mithic-media
# STORAGE_S3_ACCESS_KEY=mithic
# STORAGE_S3_SECRET_KEY=mithic-dev-secret
# STORAGE_S3_REGION=us-east-1
# STORAGE_S3_PUBLIC_URL=
LOCAL_STORAGE_PATH=./files

# Instance
INSTANCE_URL=http://localhost:3000
INSTANCE_NAME=Mithic

# VAPID (Web Push)
# VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:admin@localhost

