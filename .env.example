# SurrealDB
SURREALDB_ENDPOINT=ws://surrealdb:8000
SURREALDB_NAMESPACE=mithic
SURREALDB_DATABASE=main
SURREALDB_USERNAME=root
SURREALDB_PASSWORD=change-me

# Dragonfly (Redis-compatible)
DRAGONFLY_URL=redis://dragonfly:6379

# JWT (必須。change-me-in-production や空文字は拒否される)
JWT_SECRET=dev-only-replace-with-long-random-string
JWT_EXPIRY_HOURS=24

# リバースプロキシ背後でのみ true (X-Forwarded-For をクライアント IP に使う)
# TRUST_PROXY=false

# Server
SERVER_PORT=3000
CORS_ALLOWED_ORIGINS=http://localhost

# File storage
STORAGE_TYPE=local
LOCAL_STORAGE_PATH=/app/files

# Instance
INSTANCE_URL=http://localhost
INSTANCE_NAME=Mithic
